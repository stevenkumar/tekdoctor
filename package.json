{
  "name": "tekdoctor",
  "version": "1.0.0",
  "description": "TekDoctor monorepo — backend (Express/MySQL) + frontend (React/Vite)",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix server",
    "dev:frontend": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "start:backend": "npm run start --prefix server",
    "start:frontend": "npm run preview --prefix client",
    "test:server": "npm run test --prefix server",
    "test": "npm run test:server && npm run build --prefix client"
  },
  "workspaces": [],
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
