
NODE_ENV=development

PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tekdoctor_db

# Auto-init is ON by default (self-heals schema on boot). Set to false to freeze.
DB_AUTO_INIT=true

JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=7d

# ─── Settings Encryption at Rest (AES-256-GCM) ────
# 32-byte key (64 hex characters) used to encrypt credentials stored in site_settings.
# Generate with: openssl rand -hex 32
# Never commit a real key to version control or derive from JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=

#   Local:      http://localhost:5173,http://localhost:3000,http://localhost:3001
#   Production: https://thetekdoctor.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ─── File Uploads ─────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=uploads

# ─── Frontend Build Path ─────────────────────────
# Absolute path to the folder containing the built client/dist/index.html.
# LOCAL:     ../client/dist
# cPanel:    /home/yourusername/public_html
# Hostinger: /home/u123456789/domains/yourdomain.com/public_html
# VPS:       /var/www/tekdoctor/client/dist
FRONTEND_BUILD_PATH=../client/dist

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug


#   Local:      http://localhost:3000
#   Production: https://thetekdoctor.com
FRONTEND_URL=http://localhost:3000

# ─── Email Configuration (SMTP / Gmail) ───────────
# Option A: Standard Custom SMTP (Recommended for Production / cPanel / Mailgun / Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
FROM_EMAIL=noreply@tekdoctor.in
FROM_NAME="The Tek Doctor"

# Option B: Direct Gmail Service Fallback
# Use Gmail App Password (not regular password): https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
ADMIN_EMAIL=your-email@gmail.com


GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=

# ─── Google reCAPTCHA Enterprise (Score-based) ─────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_ENABLED=true
