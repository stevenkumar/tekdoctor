# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ─── Database (MySQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tekdoctor_db

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=your-secret-key-goes-here
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── File Uploads ─────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=uploads

# ─── Frontend Build Path ─────────────────────────
FRONTEND_BUILD_PATH=../frontend/dist

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug
