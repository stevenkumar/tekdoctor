# TekDoctor Frontend — Production Environment Variables
#
# These values are INLINED into the bundle at build time by Vite.
# After changing anything here you MUST run `npm run build` and re-upload
# client/dist, otherwise the live site keeps using the old baked-in URL.
#
# API base URL for the live cPanel deployment (same origin as the app).
VITE_API_URL=https://thetekdoctor.com
VITE_APP_ENV=production

# Public OAuth client ID (safe to ship; the client secret stays server-side).
# Must match GOOGLE_CLIENT_ID in server/.env
VITE_GOOGLE_CLIENT_ID=474030789320-8b8ohgc8rnp2uepaot9geujvkud5i8gu.apps.googleusercontent.com

# Google reCAPTCHA v3 Site Key (Web, score-based)
VITE_RECAPTCHA_SITE_KEY=6LcBVO0tAAAAAP81NLVmfuQFpD9enQNjUWIsr6Kv
