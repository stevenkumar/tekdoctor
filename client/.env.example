# TekDoctor Frontend — Example Environment Variables
#
# Copy this file to `.env` (for local development) or `.env.production` (for production builds).
# Vite inlines variables prefixed with VITE_ at BUILD TIME (`npm run build`).
# After updating any variable, rebuild the frontend bundle.

# API Base URL (empty or relative for dev proxy; full domain in production)
# Local: leave empty (Vite dev proxy forwards /api to backend) or http://localhost:5000
# Production: https://thetekdoctor.com
VITE_API_URL=

# App Environment: development | production | staging
VITE_APP_ENV=development

# Google OAuth 2.0 Web Client ID (Public identifier safe to include in frontend)
# Must match GOOGLE_CLIENT_ID in server/.env
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google reCAPTCHA v3 or Enterprise Public Site Key (Score-based)
# Must match RECAPTCHA_SITE_KEY in server/.env
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
