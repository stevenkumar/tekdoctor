# TekDoctor Frontend — Development Environment Variables
#
# VITE_API_URL is intentionally EMPTY in development: requests then stay
# same-origin (/api/...) and the Vite dev proxy forwards them to the local
# Express backend defined by VITE_DEV_PROXY_TARGET in vite.config.ts.
VITE_API_URL=
VITE_APP_ENV=development

# Local Express backend used by the dev-server proxy only.
# This is discarded at build time and never reaches the production bundle.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000

# Public OAuth client ID (safe to ship; the client secret stays server-side).
VITE_GOOGLE_CLIENT_ID=474030789320-8b8ohgc8rnp2uepaot9geujvkud5i8gu.apps.googleusercontent.com

# Google reCAPTCHA v3 Site Key (Web, score-based)
VITE_RECAPTCHA_SITE_KEY=6LcBVO0tAAAAAP81NLVmfuQFpD9enQNjUWIsr6Kv
