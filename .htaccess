# DO NOT REMOVE. cPanel / Passenger entry point for the TekDoctor Node.js app.
#
# PLACE THIS FILE IN THE DOMAIN DOCROOT (e.g. ~/public_html). It tells Apache to
# hand requests to the Node process whose startup file (server.js) lives in the
# app root below. server.js then serves the built SPA, /api/*, /uploads/* and
# /health, and performs the SPA fallback for client-side routes (so refreshing
# /dashboard, /track/123, etc. returns index.html instead of a 404).
#
# cPanel -> "Setup Node.js App" -> Save can generate this automatically. Use
# this file only if you configure the app manually. VERIFY the three paths
# against what cPanel shows for your app before uploading.

<IfModule mod_passenger.c>
    PassengerAppRoot "/home/thetekdoctor/backend"
    PassengerBaseURI "/"
    PassengerNodejs "/home/thetekdoctor/nodevenv/backend/24/bin/node"
    PassengerAppType node
    PassengerStartupFile server.js
    PassengerAppEnv production
</IfModule>

# ─── Never serve backend source or secrets as static files ───
# The app root is the docroot here, so Apache would otherwise hand out .env
# (DB password, JWT secret, Razorpay/Gmail keys) and the backend source. These
# rules mirror the guard inside server.js.
<FilesMatch "^\.(env|git|gitignore|htaccess|htpasswd)">
    Require all denied
</FilesMatch>

RedirectMatch 404 (?i)^/(node_modules|config|controllers|routes|middleware|models|utils|tests|scripts|logs)(/|$)
RedirectMatch 404 (?i)^/(server\.js|package(-lock)?\.json)$
